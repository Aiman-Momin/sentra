# Copy to .env and fill in real values. Never commit the real .env file.

PORT=4000

# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://sentra:sentra@localhost:5432/sentra?schema=public"

# Real RPC endpoint for each supported network. Get one from a provider
# like Alchemy, Infura, or a public Polygon Amoy RPC. Naming convention:
# SENTRA_RPC_<NETWORK_KEY_UPPERCASED_WITH_UNDERSCORES>
SENTRA_RPC_POLYGON_AMOY="https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY"

# Optional: JSON array of known ERC-20 tokens on a network, so Sentra can
# label transfers with symbols instead of raw contract addresses.
# SENTRA_KNOWN_TOKENS_POLYGON_AMOY=[{"address":"0x...","symbol":"USDT","decimals":6}]

# Cron expression for the monitoring job (default every 5 minutes)
SENTRA_MONITOR_CRON="*/5 * * * *"

# Set to "false" to disable the background monitoring job (e.g. in tests)
SENTRA_ENABLE_MONITORING=true
