// Sentra database schema.
// Stores: assessment history (for trend/alerting), monitored wallets, and alerts.
// It does NOT store private keys, seed phrases, or anything custodial —
// Sentra only ever persists publicly-observable chain data and derived scores.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RiskLevel {
  NORMAL
  SUSPICIOUS
  HIGH_RISK
  ACTIVE_SWEEPER_LIKELY
}

// One row per completed analysis. A wallet gets a new row every time it's
// checked or re-checked by the monitoring job, so we can track score
// history over time and detect "risk score increased" alerts.
model RiskAssessment {
  id            String    @id @default(cuid())
  address       String
  network       String
  riskScore     Int
  riskLevel     RiskLevel
  recommendation String
  // raw signal + timeline JSON from the detection engine, kept verbatim
  // so the API/UI can render full evidence without recomputation
  signals       Json
  timeline      Json
  insufficientData Boolean @default(false)
  analyzedAt    DateTime  @default(now())

  @@index([address, network, analyzedAt])
}

model MonitoredWallet {
  id          String   @id @default(cuid())
  address     String
  network     String
  label       String?
  createdAt   DateTime @default(now())
  lastCheckedAt DateTime?
  lastRiskScore Int?
  lastRiskLevel RiskLevel?
  alerts      Alert[]

  @@unique([address, network])
}

enum AlertType {
  FAST_DRAIN_DETECTED
  RISK_SCORE_INCREASED
  NEW_REPEATED_DESTINATION
}

model Alert {
  id                String          @id @default(cuid())
  monitoredWallet   MonitoredWallet @relation(fields: [monitoredWalletId], references: [id])
  monitoredWalletId String
  type              AlertType
  message           String
  previousScore     Int?
  newScore          Int?
  createdAt         DateTime        @default(now())
  acknowledgedAt    DateTime?

  @@index([monitoredWalletId, createdAt])
}

enum AddressClassification {
  SWEEPER_DESTINATION
  VERIFIED_SAFE
}

enum LearningSource {
  // Learned automatically after a HIGH_RISK/ACTIVE_SWEEPER_LIKELY
  // assessment saw the same destination drained to more than once.
  AUTO_LEARNED
  // Set by a human via the /api/feedback endpoint (false-positive report
  // or explicit confirmation), and always takes precedence over an
  // auto-learned classification for the same address.
  MANUAL
}

// This is Sentra's cross-wallet memory. It's what makes the detection
// engine "learn": a destination address confirmed as a sweeper
// collection point on one wallet immediately informs the assessment of
// any OTHER wallet that later sends to the same address (see
// KNOWN_SWEEPER_DESTINATION in the detection engine). It's also what
// makes false-positive reports actually reduce future false positives —
// a manually-verified-safe address is excluded from drain scoring going
// forward, not just for the one assessment that got reported.
model KnownAddress {
  id               String                 @id @default(cuid())
  address          String
  network          String
  classification   AddressClassification
  // 0-1. How much weight this gets in future scoring. Auto-learned
  // entries start modest and are only reinforced by repeat occurrences;
  // manual entries (from direct human feedback) start high.
  confidence       Float                  @default(0.5)
  occurrenceCount  Int                    @default(1)
  source           LearningSource
  note             String?
  firstSeenAt      DateTime               @default(now())
  lastSeenAt       DateTime               @updatedAt

  @@unique([address, network])
  @@index([network, classification])
}

// A behavioral cluster of confirmed sweeps, built from measurable
// dimensions in the data Sentra actually has (timing, assets, drain
// percentage, gas-funding, active hours) — NOT a trained ML model. This
// is deliberately transparent, rule-based similarity matching (see
// fingerprintService.ts), so every clustering decision can be traced
// back to the specific numbers that produced it.
//
// This is what lets Sentra recognize the same operator across DIFFERENT
// destination wallets — address-level learning (KnownAddress) breaks the
// moment an attacker rotates to a fresh collection address; this
// recognizes them by HOW they drain instead of WHERE the funds went.
model SweeperFingerprint {
  id                   String   @id @default(cuid())
  label                String   @unique // e.g. "SC-019", assigned sequentially
  network              String
  // Running averages, updated incrementally as new wallets match this
  // fingerprint (see fingerprintService.ts for the update formula).
  avgDrainDelaySeconds Float
  avgDrainPercentage   Float
  // 0-1 fraction of matched samples that showed a gas-funding-then-drain
  // pattern, not a single boolean — mixed evidence across samples is
  // normal and shouldn't be flattened into a false binary.
  gasFundingRatio      Float    @default(0)
  preferredAssets      Json // string[], deduped union across all samples
  activeHoursUtc       Json // number[] 0-23, deduped union across all samples
  sampleCount          Int      @default(1)
  firstSeenAt          DateTime @default(now())
  lastSeenAt           DateTime @updatedAt
  matches              SweeperFingerprintMatch[]

  @@index([network])
}

// One row per (fingerprint, victim wallet) — the audit trail behind
// "similar behavior detected across N wallets." victimCount is always
// computed live as a count of these rows, never a separately-maintained
// counter that could drift out of sync.
model SweeperFingerprintMatch {
  id              String             @id @default(cuid())
  fingerprint     SweeperFingerprint @relation(fields: [fingerprintId], references: [id])
  fingerprintId   String
  assessmentId    String
  address         String
  network         String
  similarityScore Float
  confirmed       Boolean            @default(false)
  matchedAt       DateTime           @default(now())

  @@unique([fingerprintId, address, network])
  @@index([fingerprintId])
}