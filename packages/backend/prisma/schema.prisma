// Sentra database schema.
// Stores: assessment history (for trend/alerting), monitored wallets, and alerts.
// It does NOT store private keys, seed phrases, or anything custodial —
// Sentra only ever persists publicly-observable chain data and derived scores.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RiskLevel {
  NORMAL
  SUSPICIOUS
  HIGH_RISK
  ACTIVE_SWEEPER_LIKELY
}

// One row per completed analysis. A wallet gets a new row every time it's
// checked or re-checked by the monitoring job, so we can track score
// history over time and detect "risk score increased" alerts.
model RiskAssessment {
  id            String    @id @default(cuid())
  address       String
  network       String
  riskScore     Int
  riskLevel     RiskLevel
  recommendation String
  // raw signal + timeline JSON from the detection engine, kept verbatim
  // so the API/UI can render full evidence without recomputation
  signals       Json
  timeline      Json
  insufficientData Boolean @default(false)
  analyzedAt    DateTime  @default(now())

  @@index([address, network, analyzedAt])
}

model MonitoredWallet {
  id          String   @id @default(cuid())
  address     String
  network     String
  label       String?
  createdAt   DateTime @default(now())
  lastCheckedAt DateTime?
  lastRiskScore Int?
  lastRiskLevel RiskLevel?
  alerts      Alert[]

  @@unique([address, network])
}

enum AlertType {
  FAST_DRAIN_DETECTED
  RISK_SCORE_INCREASED
  NEW_REPEATED_DESTINATION
}

model Alert {
  id                String          @id @default(cuid())
  monitoredWallet   MonitoredWallet @relation(fields: [monitoredWalletId], references: [id])
  monitoredWalletId String
  type              AlertType
  message           String
  previousScore     Int?
  newScore          Int?
  createdAt         DateTime        @default(now())
  acknowledgedAt    DateTime?

  @@index([monitoredWalletId, createdAt])
}

enum AddressClassification {
  SWEEPER_DESTINATION
  VERIFIED_SAFE
}

enum LearningSource {
  // Learned automatically after a HIGH_RISK/ACTIVE_SWEEPER_LIKELY
  // assessment saw the same destination drained to more than once.
  AUTO_LEARNED
  // Set by a human via the /api/feedback endpoint (false-positive report
  // or explicit confirmation), and always takes precedence over an
  // auto-learned classification for the same address.
  MANUAL
}

// This is Sentra's cross-wallet memory. It's what makes the detection
// engine "learn": a destination address confirmed as a sweeper
// collection point on one wallet immediately informs the assessment of
// any OTHER wallet that later sends to the same address (see
// KNOWN_SWEEPER_DESTINATION in the detection engine). It's also what
// makes false-positive reports actually reduce future false positives —
// a manually-verified-safe address is excluded from drain scoring going
// forward, not just for the one assessment that got reported.
model KnownAddress {
  id               String                 @id @default(cuid())
  address          String
  network          String
  classification   AddressClassification
  // 0-1. How much weight this gets in future scoring. Auto-learned
  // entries start modest and are only reinforced by repeat occurrences;
  // manual entries (from direct human feedback) start high.
  confidence       Float                  @default(0.5)
  occurrenceCount  Int                    @default(1)
  source           LearningSource
  note             String?
  firstSeenAt      DateTime               @default(now())
  lastSeenAt       DateTime               @updatedAt

  @@unique([address, network])
  @@index([network, classification])
}